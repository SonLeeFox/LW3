<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:StudentsJsonApp"
             x:Class="StudentsJsonApp.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F1115">

    <Grid>

        <Grid RowDefinitions="38,*,24" ColumnDefinitions="330,*">

            <Grid Grid.Row="0" Grid.ColumnSpan="2"
                  BackgroundColor="#16191F"
                  Padding="10,0"
                  ColumnDefinitions="Auto,*,Auto">

                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <BoxView WidthRequest="8" HeightRequest="8" Color="#3B82F6" VerticalOptions="Center" />
                    <Label Text="JSON INSPECTOR"
                           TextColor="#F3F4F6"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="0.8"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label x:Name="FileLabel"
                       Grid.Column="1"
                       Text="Новий файл (не збережено)"
                       TextColor="#9CA3AF"
                       FontSize="11"
                       Margin="16,0"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />

                <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                    <Button Text="Файл ▾"
                            Clicked="OnFileMenuClicked"
                            HeightRequest="26"
                            MinimumHeightRequest="26"
                            Padding="10,0"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="0"
                            BackgroundColor="#2563EB"
                            TextColor="#FFFFFF" />
                    <Button Text="Про програму"
                            Clicked="OnAboutClicked"
                            HeightRequest="26"
                            MinimumHeightRequest="26"
                            Padding="8,0"
                            FontSize="11"
                            CornerRadius="0"
                            BackgroundColor="#1F242D"
                            TextColor="#93C5FD"
                            BorderColor="#2D333F"
                            BorderWidth="1" />
                    <Button Text="Вихід"
                            Clicked="OnExitClicked"
                            HeightRequest="26"
                            MinimumHeightRequest="26"
                            Padding="8,0"
                            FontSize="11"
                            CornerRadius="0"
                            BackgroundColor="#3B1818"
                            TextColor="#FCA5A5"
                            BorderColor="#7F1D1D"
                            BorderWidth="1" />
                </HorizontalStackLayout>
            </Grid>

            <Border Grid.Row="1" Grid.Column="0"
                    BackgroundColor="#13161C"
                    Stroke="#262B36"
                    StrokeThickness="1"
                    Padding="10">

                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="ПОШУК ЗА КРИТЕРІЯМИ (LINQ)"
                               TextColor="#9CA3AF"
                               FontSize="11"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Скинути"
                                Clicked="OnResetClicked"
                                HeightRequest="22"
                                MinimumHeightRequest="22"
                                Padding="8,0"
                                FontSize="10"
                                CornerRadius="0"
                                BackgroundColor="#1F242D"
                                TextColor="#D1D5DB"
                                BorderColor="#2D333F"
                                BorderWidth="1" />
                    </Grid>

                    <ScrollView Grid.Row="1" Padding="0,0,6,0">
                        <VerticalStackLayout Spacing="8">

                            <VerticalStackLayout Spacing="3">
                                <Label Text="ПІБ студента" TextColor="#9CA3AF" FontSize="11" />
                                <Border Stroke="#262B36" StrokeThickness="1" BackgroundColor="#0F1115" HeightRequest="32">
                                    <Entry x:Name="SearchNameEntry"
                                           Placeholder="Введіть прізвище або ім'я..."
                                           PlaceholderColor="#4B5563"
                                           TextColor="#F3F4F6"
                                           BackgroundColor="Transparent"
                                           FontSize="12"
                                           MaxLength="100"
                                           Completed="OnSearchClicked" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Факультет" TextColor="#9CA3AF" FontSize="11" />
                                <Border Stroke="#262B36" StrokeThickness="1" BackgroundColor="#0F1115" HeightRequest="32">
                                    <Entry x:Name="SearchFacultyEntry"
                                           Placeholder="Наприклад: ФКНК"
                                           PlaceholderColor="#4B5563"
                                           TextColor="#F3F4F6"
                                           BackgroundColor="Transparent"
                                           FontSize="12"
                                           MaxLength="100"
                                           Completed="OnSearchClicked" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Кафедра" TextColor="#9CA3AF" FontSize="11" />
                                <Border Stroke="#262B36" StrokeThickness="1" BackgroundColor="#0F1115" HeightRequest="32">
                                    <Entry x:Name="SearchDepartmentEntry"
                                           Placeholder="Назва кафедри..."
                                           PlaceholderColor="#4B5563"
                                           TextColor="#F3F4F6"
                                           BackgroundColor="Transparent"
                                           FontSize="12"
                                           MaxLength="100"
                                           Completed="OnSearchClicked" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Навчальна дисципліна" TextColor="#9CA3AF" FontSize="11" />
                                <Border Stroke="#262B36" StrokeThickness="1" BackgroundColor="#0F1115" HeightRequest="32">
                                    <Entry x:Name="SearchSubjectEntry"
                                           Placeholder="Назва предмета..."
                                           PlaceholderColor="#4B5563"
                                           TextColor="#F3F4F6"
                                           BackgroundColor="Transparent"
                                           FontSize="12"
                                           MaxLength="100"
                                           Completed="OnSearchClicked" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="3">
                                <Label Text="Діапазон оцінок (0–100)" TextColor="#9CA3AF" FontSize="11" />
                                <Grid ColumnDefinitions="*,16,*" ColumnSpacing="4">
                                    <Border Grid.Column="0" Stroke="#262B36" StrokeThickness="1" BackgroundColor="#0F1115" HeightRequest="32">
                                        <Entry x:Name="MinGradeEntry"
                                               Placeholder="Від (0)"
                                               PlaceholderColor="#4B5563"
                                               TextColor="#F3F4F6"
                                               BackgroundColor="Transparent"
                                               HorizontalTextAlignment="Center"
                                               Keyboard="Numeric"
                                               MaxLength="3"
                                               FontSize="12"
                                               Completed="OnSearchClicked" />
                                    </Border>
                                    <Label Grid.Column="1" Text="—" TextColor="#6B7280" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border Grid.Column="2" Stroke="#262B36" StrokeThickness="1" BackgroundColor="#0F1115" HeightRequest="32">
                                        <Entry x:Name="MaxGradeEntry"
                                               Placeholder="До (100)"
                                               PlaceholderColor="#4B5563"
                                               TextColor="#F3F4F6"
                                               BackgroundColor="Transparent"
                                               HorizontalTextAlignment="Center"
                                               Keyboard="Numeric"
                                               MaxLength="3"
                                               FontSize="12"
                                               Completed="OnSearchClicked" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <Button Text="ЗНАЙТИ"
                                    Clicked="OnSearchClicked"
                                    Margin="0,4,0,0"
                                    HeightRequest="32"
                                    MinimumHeightRequest="32"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    CornerRadius="0"
                                    BackgroundColor="#2563EB"
                                    TextColor="#FFFFFF" />

                        </VerticalStackLayout>
                    </ScrollView>

                    <Border Grid.Row="2"
                            BackgroundColor="#16191F"
                            Stroke="#262B36"
                            StrokeThickness="1"
                            Padding="8">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="КЕРУВАННЯ ЗАПИСАМИ"
                                   TextColor="#6B7280"
                                   FontSize="10"
                                   FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                <Button Grid.Column="0"
                                        Text="+ Додати"
                                        Clicked="OnAddClicked"
                                        HeightRequest="30"
                                        MinimumHeightRequest="30"
                                        Padding="4,0"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="0"
                                        BackgroundColor="#065F46"
                                        TextColor="#ECFDF5" />

                                <Button Grid.Column="1"
                                        Text="Редагувати"
                                        Clicked="OnEditClicked"
                                        HeightRequest="30"
                                        MinimumHeightRequest="30"
                                        Padding="4,0"
                                        FontSize="11"
                                        CornerRadius="0"
                                        BackgroundColor="#1F242D"
                                        TextColor="#E5E7EB"
                                        BorderColor="#2D333F"
                                        BorderWidth="1" />

                                <Button Grid.Column="2"
                                        Text="Видалити"
                                        Clicked="OnDeleteClicked"
                                        HeightRequest="30"
                                        MinimumHeightRequest="30"
                                        Padding="4,0"
                                        FontSize="11"
                                        CornerRadius="0"
                                        BackgroundColor="#3B1818"
                                        TextColor="#FCA5A5"
                                        BorderColor="#7F1D1D"
                                        BorderWidth="1" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1"
                  RowDefinitions="30,32,*"
                  BackgroundColor="#0F1115">

                <Grid Grid.Row="0"
                      BackgroundColor="#16191F"
                      Padding="12,0"
                      ColumnDefinitions="*,Auto">
                    <Label Text="ТАБЛИЦЯ УСПІШНОСТІ СТУДЕНТІВ"
                           TextColor="#9CA3AF"
                           FontSize="11"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Label x:Name="MetricsLabel"
                           Grid.Column="1"
                           Text="0 із 0 записів"
                           TextColor="#60A5FA"
                           FontSize="11"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </Grid>

                <Grid Grid.Row="1"
                      Padding="12,0"
                      ColumnSpacing="8"
                      ColumnDefinitions="2*,1.5*,1.5*,52,1.5*,64"
                      BackgroundColor="#1A1E26">
                    <Label Grid.Column="0" Text="ПІБ" TextColor="#93C5FD" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="ФАКУЛЬТЕТ" TextColor="#93C5FD" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="КАФЕДРА" TextColor="#93C5FD" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="КУРС" TextColor="#93C5FD" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Label Grid.Column="4" Text="ДИСЦИПЛІНА" TextColor="#93C5FD" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="5" Text="ОЦІНКА" TextColor="#93C5FD" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                </Grid>

                <CollectionView x:Name="StudentsView"
                                Grid.Row="2"
                                SelectionMode="Single"
                                BackgroundColor="#0F1115">
                    <CollectionView.EmptyView>
                        <Label Text="Список порожній. Відкрийте JSON-файл через «Файл ▾» або натисніть «+ Додати»."
                               TextColor="#4B5563"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:Student">
                            <VerticalStackLayout>
                                <Grid Padding="12,8"
                                      ColumnSpacing="8"
                                      ColumnDefinitions="2*,1.5*,1.5*,52,1.5*,64">
                                    <Label Grid.Column="0" Text="{Binding FullName}" TextColor="#F3F4F6" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Faculty}" TextColor="#D1D5DB" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Department}" TextColor="#D1D5DB" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Course}" TextColor="#9CA3AF" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                    <Label Grid.Column="4" Text="{Binding Subject}" TextColor="#E5E7EB" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="5" Text="{Binding Grade}" TextColor="#60A5FA" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#1F242D" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Row="2" Grid.ColumnSpan="2"
                  BackgroundColor="#1E3A8A"
                  Padding="10,0"
                  ColumnDefinitions="*,Auto">
                <Label x:Name="StatusLabel"
                       Grid.Column="0"
                       Text="Готово до роботи."
                       TextColor="#EFF6FF"
                       FontSize="11"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Варіант 6 • JSON"
                       TextColor="#BFDBFE"
                       FontSize="11"
                       VerticalOptions="Center" />
            </Grid>

        </Grid>

        <Grid x:Name="ModalOverlay"
              IsVisible="False"
              BackgroundColor="#B0000000">
            <Border WidthRequest="440"
                    MaximumHeightRequest="460"
                    BackgroundColor="#16191F"
                    Stroke="#3B82F6"
                    StrokeThickness="1"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="0">
                <Grid RowDefinitions="34,*,Auto">
                    <Grid Grid.Row="0"
                          BackgroundColor="#1E232D"
                          Padding="12,0"
                          ColumnDefinitions="*,Auto">
                        <Label x:Name="ModalTitleLabel"
                               Grid.Column="0"
                               TextColor="#F3F4F6"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Clicked="OnCloseModalClicked"
                                WidthRequest="26"
                                HeightRequest="24"
                                MinimumHeightRequest="24"
                                Padding="0"
                                FontSize="11"
                                CornerRadius="0"
                                BackgroundColor="Transparent"
                                TextColor="#9CA3AF" />
                    </Grid>

                    <ScrollView Grid.Row="1" Padding="12">
                        <VerticalStackLayout x:Name="ModalContentPanel" Spacing="8" />
                    </ScrollView>

                    <Grid Grid.Row="2"
                          BackgroundColor="#13161C"
                          Padding="12,8">
                        <Button Text="Закрити"
                                Clicked="OnCloseModalClicked"
                                HorizontalOptions="End"
                                HeightRequest="26"
                                MinimumHeightRequest="26"
                                Padding="14,0"
                                FontSize="11"
                                CornerRadius="0"
                                BackgroundColor="#262B36"
                                TextColor="#E5E7EB" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>